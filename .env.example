# Шаблон. Скопируйте этот файл под именем .env и впишите свои значения.
# Сам файл .env на GitHub не попадает (он указан в .gitignore).
# Подробно, где взять каждое значение: INSTRUCTION.md (шаги 6–7).
# Секретный ключ и пароль от базы не нужны: сайт обращается
# к Supabase напрямую публичным ключом, а права проверяет база данных.

# Адрес проекта Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co

# Публичный ключ: «anon public» или «Publishable key»
NEXT_PUBLIC_SUPABASE_ANON_KEY=ВАШ_ПУБЛИЧНЫЙ_КЛЮЧ
